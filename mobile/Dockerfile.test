# Mobile unit tests + typecheck, used by scripts/test.sh (CI and deploys).
# Build context is the repo root (the app imports packages/shared):
#   docker build -f mobile/Dockerfile.test .
FROM node:22-alpine
WORKDIR /repo/mobile
COPY mobile/package.json mobile/package-lock.json ./
RUN npm ci --no-audit --no-fund --loglevel=error
COPY mobile/ .
COPY packages/ /repo/packages/
RUN npx tsc --noEmit && npx jest --ci
