{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest",
      "node"
    ],
    "paths": {
      "@jobswipe/shared/*": [
        "../packages/shared/src/*"
      ]
    },
    "resolveJsonModule": true
  },
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "build"
  ]
}
